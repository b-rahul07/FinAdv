# FinAdvisor API settings (finadvisor/settings.py). Copy to .env; never commit .env.

APP_ENV=dev                       # dev | prod
DATABASE_URL=                     # empty = sqlite data/finadvisor.db; production: postgresql+psycopg://... (Supabase pooler)
CORS_ORIGINS=http://localhost:5173

# Sign-in: dev issues local tokens (refused when APP_ENV=prod); supabase verifies Supabase Auth sessions
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_ANON_KEY=                # public key
SUPABASE_SERVICE_KEY=             # server only, optional: lets "delete account" remove the Supabase sign-in
SUPABASE_JWT_SECRET=              # only for legacy HS256 projects

# Models and data
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=website                # key in configs/models.yaml
RETRIEVAL=chroma                  # chroma (needs the rag extra and scripts/build_index.py) | keyword
NEWS=rss                          # rss (ET Markets + Moneycontrol, FinBERT mood; needs the news extra) | off
