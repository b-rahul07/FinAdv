# FinAdvisor API settings (finadvisor/settings.py). Copy to .env; never commit .env.
# Empty values use the defaults. Keep comments on their own lines (text after a value is read as part of it).

# dev | prod
APP_ENV=dev
# Empty = local SQLite file data/finadvisor.db. Production: postgresql+psycopg://... (Supabase session pooler)
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sign-in. dev: local sign-in with any email (refused when APP_ENV=prod). supabase: real Supabase accounts.
AUTH_MODE=dev
SUPABASE_URL=
# Public anon key (safe in browsers; database rules block it from reading data)
SUPABASE_ANON_KEY=
# Server-only secret, optional: lets "delete account" also remove the Supabase sign-in
SUPABASE_SERVICE_KEY=
# Only for legacy HS256 Supabase projects
SUPABASE_JWT_SECRET=

# Models and data
OLLAMA_BASE_URL=http://localhost:11434
# Key in configs/models.yaml
MODEL_NAME=website
# chroma (needs the rag extra and scripts/build_index.py) | keyword
RETRIEVAL=chroma
# rss (ET Markets + Moneycontrol headlines with FinBERT mood; needs the news extra) | off
NEWS=rss
