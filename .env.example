# AI Financial Advisor MVP — Environment Variables

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini

# ChromaDB (local persistent storage)
CHROMA_PERSIST_DIR=./data/chroma_db

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# FinBERT model
FINBERT_MODEL=ProsusAI/finbert

# Headline fetching (optional API key for news sources)
NEWS_API_KEY=

# Eval: LLM-as-judge (paid API — only used for eval harness)
JUDGE_API_KEY=
JUDGE_MODEL=gpt-4o-mini

# Supabase (session & message persistence)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Logging
LOG_LEVEL=INFO
