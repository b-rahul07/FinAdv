# Copy to web/.env.local. Keep comments on their own lines.
VITE_API_URL=http://localhost:8000

# Leave both empty for the local development sign-in (any email, no password; the API must run with AUTH_MODE=dev).
# For real Supabase sign-in, set the project URL and its public anon key (never the service key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true shows "Continue with Google" (only works with Supabase sign-in and Google enabled in the Supabase project)
VITE_GOOGLE_AUTH=false
